# Copy to .env and fill in. NEVER commit .env or put real keys in this example file.

# --- Provider keys (kept only on this server) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Default models. Use model IDs listed in each provider's CURRENT official docs (they change over time). ---
# The app can also send its own model ID per request, and /v1/models lists what your key can use.
OPENAI_MODEL=
GEMINI_MODEL=

# --- Optional external TTS voice (OpenAI audio/speech). Leave blank to disable. ---
# Example voice IDs and models are in OpenAI's text-to-speech docs. Disclose to users that the voice is AI-generated.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# --- Security ---
# Shared secret the Android app sends as "Authorization: Bearer <token>". Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=30
# Comma-separated browser origins allowed by CORS (the Android app does not need CORS). Empty = none.
CORS_ORIGINS=
# Set true only when running behind your own reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
